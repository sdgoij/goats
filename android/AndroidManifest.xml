<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest: a NativeActivity subclass around the client's cdylib.

  `lib_name` is the base name of `libgoats_android.so`, and the framework's
  NativeActivity looks up `ANativeActivity_onCreate` in it. The class the launcher
  names is `GoatsActivity` rather than the framework's own, because P2 needs Java
  for the soft keyboard, the clipboard and the insets (ANDROID.md D6); that is also
  why `hasCode` is true and the APK carries a `classes.dex`.

  minSdkVersion is 26 because that is where `libaaudio.so` starts and `cpal`'s
  AAudio host links `-laudio`; see risk 6 in ANDROID.md.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.sdgoij.goats"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <!-- The build is an ES3 build (ANDROID.md D4 and risk 2): raylib is compiled
         with GRAPHICS_API_OPENGL_ES3 and the EGL context is requested as 3, so
         the app needs an ES 3.0 driver. Declaring it keeps the APK off ES
         2.0-only devices rather than letting it install and fail at the first
         `#version 300 es` compile. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="goats"
        android:hasCode="true"
        android:debuggable="true"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- `adjustResize` rather than the default: the console draws into the
             panel the app owns, so the panel has to *shrink* above the keyboard
             instead of the keyboard covering what is being typed into. -->
        <activity
            android:name="dev.sdgoij.goats.GoatsActivity"
            android:label="goats"
            android:exported="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="goats_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
