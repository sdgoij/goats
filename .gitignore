android/.idea
android/android.iml
raylib-rs/
slag/
target/
*.png
# The README's screenshots are the one PNG set the repository carries.
!/screenshot1.png
!/screenshot2.png
# Vendored Sky3D textures: the `*.png` rule above is for screenshots and would
# otherwise leave the addon's moon map, icon and noise textures out.
!/godot/addons/sky_3d/assets/**/*.png
*.mp4
*.blend1
#*.pyc
web/dist

# The browser export and the shell copy `godot/tools/package_web.sh` produces,
# and the zips it stages inside the Godot project for the Web preset's filter.
/dist-web/
/godot/bundled_mods/

# A world mod a host fetched at join time (M18). Local to this checkout, and the
# game writes it wherever `mods/` is.
mods/pulled-*
mods/pulled.json
# The registry's blob store and a fetch's staging directory: both are the game's
# own working state under `mods/`, and neither is a mod.
mods/.registry/
mods/.staging/
# `goatsd`'s default store when it is run without a mods directory.
/.registry/
