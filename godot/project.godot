; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Slag Goat"
config/description="Godot port of the Slag Goat sandbox (see PORT.md)."
run/main_scene="res://scenes/herd.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[dotnet]

project/assembly_name="Slag Goat"

[editor_plugins]

enabled=PackedStringArray("res://addons/sky_3d/plugin.cfg")

[importer_defaults]

scene={
"gltf/embedded_image_handling": 3
}

[audio]

; The microphone: `voice.gd` plays an `AudioStreamMicrophone` onto its capture bus, and without
; this Godot never opens the input device (so the capture is silence rather than an error).
; A browser tab is different: voice is compiled out of the web build (`WEB.md`), and asking for
; the microphone at startup is a permission prompt and a `NotAllowedError` for nothing.
driver/enable_input=true
driver/enable_input.web=false

[rendering]

; Desktop keeps Forward+; the browser can only run Godot's Compatibility
; (WebGL 2) renderer, and the `web` feature tag picks that at load time
; (`godot/WEB.md`).
renderer/rendering_method="forward_plus"
renderer/rendering_method.web="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
